generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  regNo     String?  @unique
  password  String?
  // True until the person has chosen their own password (set for every issued or reset password)
  mustChangePassword Boolean @default(false)
  // Goes up on every password change or reset; sign-in tokens carry the number they were issued with
  tokenVersion Int @default(0)
  activatedAt DateTime?
  name      String
  role      Role     @default(RESIDENT)
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedRequests CleaningRequest[] @relation("RequestedRequests")
  cleanerRequests   CleaningRequest[] @relation("CleanerRequests")
  confirmedRequests CleaningRequest[] @relation("ConfirmedRequests")

  @@index([roomId])
  @@index([email])
}

model Room {
  id          String   @id @default(cuid())
  number      String   @unique
  building    String
  floor       Int
  capacity    Int      @default(4)
  residents   User[]
  requests    CleaningRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([number])
}

model CleaningRequest {
  id          String           @id @default(cuid())
  roomId      String
  room        Room             @relation(fields: [roomId], references: [id])
  // Emptied when the student is removed, so the cleaning history and its ratings stay accurate
  requestedBy String?
  requester   User?            @relation("RequestedRequests", fields: [requestedBy], references: [id], onDelete: SetNull)
  status      CleaningStatus   @default(PENDING)
  cleanerId   String?
  cleaner     User?            @relation("CleanerRequests", fields: [cleanerId], references: [id])
  confirmedBy String?
  confirmer   User?            @relation("ConfirmedRequests", fields: [confirmedBy], references: [id])
  requestedAt DateTime         @default(now())
  claimedAt   DateTime?
  cleanedAt   DateTime?
  confirmedAt DateTime?
  rejectReason String?
  rating      Int?
  feedback    String?
  overdueAlertedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([roomId])
  @@index([status])
  @@index([cleanerId])
  @@index([requestedAt])
}

enum Role {
  RESIDENT
  CLEANER
  ADMIN
}

enum CleaningStatus {
  PENDING
  IN_PROGRESS
  CLEANED
  CONFIRMED
  REJECTED
}

// Shared counters for login throttling (works across parallel function instances)
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
