# Database (local Docker Postgres). On Neon these are injected automatically.
DATABASE_URL="postgresql://postgres:password@localhost:5432/hostel_cleaning?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"

# Admin account created by the seed script
ADMIN_EMAIL="admin@hostel.com"
SEED_PASSWORD="change-me-before-seeding"

# Optional: lets people sign in with Google (Google Cloud OAuth "Web" client id)
GOOGLE_CLIENT_ID=""
# Optional: emails that become admins on first Google sign-in, comma separated
ADMIN_EMAILS=""

# Optional: email each new person their password (a Gmail address with an app password works, ~500 mails a day)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# Website address shown in the email (defaults to CLIENT_URL)
APP_URL=""
